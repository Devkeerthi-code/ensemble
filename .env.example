# ---------- Required ----------

# Postgres connection string. On Neon use the *pooled* URL (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional: direct (non-pooled) URL for the pg-boss job queue. If unset, Ensemble drops "-pooler" from DATABASE_URL.
DIRECT_DATABASE_URL=""

# Auth.js session secret. Generate: openssl rand -base64 32
AUTH_SECRET=""

# 32 random bytes, base64. Encrypts users' provider API keys (AES-256-GCM). Generate: openssl rand -base64 32
# Changing it makes every stored key unreadable (users would need to re-enter them).
ENCRYPTION_KEY=""

# Comma-separated emails that can open /admin (usage counts, audit log, kill switch).
ADMIN_EMAILS=""

# ---------- Shared provider keys (optional) ----------
# Used for any user who hasn't added their own key. Free tiers: Gemini, Groq, OpenRouter ":free" models.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Local models via Ollama (worker machine only), e.g. http://localhost:11434/api
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2"

# ---------- Safety limits (optional, defaults shown) ----------
DAILY_BUDGET_USD="2"          # Hard cap per user per day, across all runs
MAX_RUN_BUDGET_USD="5"        # Largest budget a single run may set
APPROVAL_THRESHOLD_USD="0.25" # Any single step estimated above this waits for the user's approval
WORKER_CONCURRENCY="8"        # Parallel task steps per worker process
PER_USER_CONCURRENCY="4"      # Parallel model calls per user
