generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  setups       SetupProfile[]
}

/// A saved questionnaire. Files are regenerated from `answers` + `templateVersion`, so we never store stale output.
model SetupProfile {
  id              String   @id @default(cuid())
  userId          String
  name            String   @db.VarChar(80)
  answers         Json
  templateVersion String   @db.VarChar(16)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
}

/// Counts only: no user id, no IP, no content.
model UsageEvent {
  id        BigInt   @id @default(autoincrement())
  event     String   @db.VarChar(40)
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}

/// Fixed-window rate limit counters, shared across serverless instances.
model RateLimit {
  key         String   @db.VarChar(120)
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Append-only record of security-relevant actions. `meta` never holds secrets or content.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  action    String   @db.VarChar(60)
  target    String?  @db.VarChar(120)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt])
}
